+    }
+    transcript = transcript_from_thread(thread)
+    assert "暗号是四十二" in transcript
+    assert "PRIVATE" not in transcript and "OLD SIDE" not in transcript
+    assert len(transcript) < 16100 and "t" * 801 not in transcript
