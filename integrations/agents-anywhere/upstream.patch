+    "kind": {
+      "enum": [
+        "state",
+        "pairing"
+      ],
+      "title": "Kind",
+      "type": "string"
+    },
+    "state": {
+      "anyOf": [
+        {
+          "$ref": "#/$defs/ConnectorState"
+        },
+        {
+          "type": "null"
+        }
+      ],
+      "default": null
+    },
+    "pairing": {
+      "anyOf": [
+        {
+          "$ref": "#/$defs/PairingStatus"
+        },
+        {
+          "type": "null"
+        }
+      ],
+      "default": null
+    }
+  },
+  "required": [
+    "seq",
+    "kind"
+  ],
+  "title": "ControlEvent",
+  "type": "object"
+};
+
+/**
+ * One Connector for every local Agent: state, identity, account binding and lifecycle.
+ */
+export class SharedServiceClient {
+  public constructor(private readonly rpc: MeshCallRpc) {}
+
+  public withOptions(options: CallOptions): SharedServiceClient {
+    return new SharedServiceClient(this.rpc.withOptions(options));
+  }
+
+  /**
+   * The runtime's status and the last error it reported.
+   */
+  public getState(
+    options?: CallOptions,
+  ): Promise<ConnectorState> {
+    return this.rpc.unary<SharedServiceGetStateRequest, ConnectorState>(
+      "aa.local.v2.Shared",
+      "getState",
+      {},
+      { idempotent: true, ...options, responseSchema: ConnectorStateSchema },
+    );
+  }
+
+  /**
+   * The saved device identity, without its token; empty before the first binding.
+   */
+  public getIdentity(
+    options?: CallOptions,
+  ): Promise<ConnectorIdentity> {
+    return this.rpc.unary<SharedServiceGetIdentityRequest, ConnectorIdentity>(
+      "aa.local.v2.Shared",
+      "getIdentity",
+      {},
+      { idempotent: true, ...options, responseSchema: ConnectorIdentitySchema },
+    );
+  }
+
+  /**
+   * Keep the saved identity for this account, or register this machine once.
+   */
+  public attachAccount(
+    serverUrl: string,
+    userId: string,
+    accessToken: string,
+    recovery: string | null = null,
+    options?: CallOptions,
+  ): Promise<ConnectorIdentity> {
+    return this.rpc.unary<SharedServiceAttachAccountRequest, ConnectorIdentity>(
+      "aa.local.v2.Shared",
+      "attachAccount",
+      {
+        serverUrl: serverUrl,
+        userId: userId,
+        accessToken: accessToken,
+        recovery: recovery,
+      },
+      { ...options, responseSchema: ConnectorIdentitySchema },
+    );
+  }
+
+  /**
+   * Start the runtime tasks with the saved configuration.
+   */
+  public start(
+    options?: CallOptions,
+  ): Promise<ConnectorState> {
+    return this.rpc.unary<SharedServiceStartRequest, ConnectorState>(
+      "aa.local.v2.Shared",
+      "start",
+      {},
+      { ...options, responseSchema: ConnectorStateSchema },
+    );
+  }
+
+  /**
+   * Stop every runtime; the service and its device identity stay up.
+   */
+  public stop(
+    options?: CallOptions,
+  ): Promise<ConnectorState> {
+    return this.rpc.unary<SharedServiceStopRequest, ConnectorState>(
+      "aa.local.v2.Shared",
+      "stop",
+      {},
+      { ...options, responseSchema: ConnectorStateSchema },
+    );
+  }
+
+  /**
+   * Stop, then start the runtime tasks with the saved configuration.
+   */
+  public restart(
+    options?: CallOptions,
+  ): Promise<ConnectorState> {
+    return this.rpc.unary<SharedServiceRestartRequest, ConnectorState>(
+      "aa.local.v2.Shared",
+      "restart",
+      {},
+      { ...options, responseSchema: ConnectorStateSchema },
+    );
+  }
+
+  /**
+   * State events after since; read getState for the current state.
+   */
+  public events(
+    since: number | null = null,
+    options?: CallOptions,
+  ): RpcStream<ControlEvent> {
+    return this.rpc.serverStream<SharedServiceEventsRequest, ControlEvent>(
+      "aa.local.v2.Shared",
+      "events",
+      {
+        since: since,
+      },
+      { idempotent: true, ...options, itemSchema: ControlEventSchema },
+    );
+  }
+}
