 def default_runtime_providers() -> tuple[RuntimeProvider, ...]:
-    return (CodexProvider(), ClaudeProvider(), DshProvider())
+    providers: list[RuntimeProvider] = [
+        CodexProvider(),
+        ClaudeProvider(),
+        DshProvider(),
+    ]
